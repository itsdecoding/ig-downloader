# InstaFetch Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional: Residential or Rotating Proxy (Required for cloud deployments like Render, Railway, AWS)
# Format: http://username:password@proxy-host.com:port
# Examples:
# PROXY_URL=http://user123:pass456@p.webshare.io:80
# PROXY_URL=http://customer-xyz:pass123@pr.brightdata.com:22225

# Optional: search + analytics tags. Blank means neither tag is shipped.
# Search Console -> Settings -> Ownership verification -> HTML tag -> copy the content value.
# GOOGLE_SITE_VERIFICATION=
# Cloudflare dashboard -> Web Analytics -> add site -> copy the token.
# CF_ANALYTICS_TOKEN=
